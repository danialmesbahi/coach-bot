# Replace BOT_DOMAIN with your real HTTPS domain.
# Front door for the entire panel and bot. Bind ingress to loopback on a public VPS.
# Add ONLY this proxy's verified Docker-facing source IP to trusted-proxies.conf.
# Otherwise all visitors intentionally share a rate bucket (fail-safe, not scalable).
server {
    listen 443 ssl http2;
    server_name BOT_DOMAIN;

    # Use certificates from Let's Encrypt/your CA.
    ssl_certificate     /etc/letsencrypt/live/BOT_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/BOT_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_prefer_server_ciphers off;

    # Inner ingress enforces route-specific upload limits. Stream request bodies
    # here so approved catalog videos do not hit an unrelated edge limit.
    client_max_body_size 0;
    client_body_timeout 20s;
    proxy_request_buffering off;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_buffering off;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_read_timeout 70s;
    }

    location = /api/catalog-assets {
        proxy_pass http://127.0.0.1:8090;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ~ ^/api/orders/[0-9]+/plan$ {
        proxy_pass http://127.0.0.1:8090;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}

server {
    listen 80;
    server_name BOT_DOMAIN;

    # Certbot's webroot challenge must stay reachable for automatic renewal.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
